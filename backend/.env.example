# ─── Eskiz.uz SMS Gateway ───────────────────────────────────────
# Ro'yxatdan o'tish: https://eskiz.uz
# Dashboard → Profile → API → Email va Password ni oling
ESKIZ_EMAIL=your_eskiz_email@example.com
ESKIZ_PASSWORD=your_eskiz_password
# Sender ID: test uchun "4546", yoki Eskiz da ro'yxatga olingan nom
ESKIZ_SENDER=4546

# ─── OTP sozlamalari ─────────────────────────────────────────────
PHONE_OTP_EXPIRY_SECONDS=300
PHONE_OTP_RESEND_SECONDS=45
# Haqiqiy SMS yo'q, debug kod qaytariladi (faqat dev uchun)
PHONE_OTP_DEBUG=false

# ─── Boshqa ──────────────────────────────────────────────────────
# SMS_API_URL=  # agar boshqa SMS webhook ishlatsangiz
# SMS_API_TOKEN=
